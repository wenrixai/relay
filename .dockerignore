# Keep the image build context small and free of anything the runtime image doesn't need.
# NOTE: the main Dockerfile copies README.md, and Dockerfile.mockserver copies
# deployment/mock_channel.py — both are preserved below.
.git
.github
.gitignore
.dockerignore
.agents
.codex

# Tests, docs, specs, perf — not part of any image.
tests
docs
openspec
perf

# deployment/ is excluded except the mock channel used by Dockerfile.mockserver.
deployment/*
!deployment/mock_channel.py

# Repo docs that are not copied into the image (README.md is intentionally kept).
*CLAUDE*
CONTRIBUTING.md
RELEASE_CHECKLIST.md

# Python caches / local envs.
.venv
build
dist
*.egg-info
__pycache__
*.pyc
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
coverage.xml
htmlcov
.tox
.nox

# Editor / OS cruft.
.idea
.vscode
.DS_Store

# Local tool and dependency caches.
.cache
.terraform
.terragrunt-cache
node_modules
*.log
